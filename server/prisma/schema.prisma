/**
 * Reminder / escalation rules for the HR alerts engine (/app/hr/alerts).
 *
 * The manager portal's alerts are derived on the fly from the data (domain/manager/alerts.js);
 * what HR configures here is the *policy* behind reminders — which situation triggers a
 * reminder, after how many days, who is notified, and when it escalates. That policy has no
 * home in the existing schema, so it gets its own table rather than being stuffed into
 * AppSetting as opaque JSON, which would make "which rules exist" unqueryable.
 */
model AlertRule {
  id                String              @id @default(uuid()) @db.Uuid
  labelFr           String
  trigger           String // "TASK_OVERDUE" | "SURVEY_UNANSWERED" | "EVALUATION_DUE"
  thresholdDays     Int                 @default(3)
  notifyDepartment  TaskOwnerDepartment @default(HR)
  escalateAfterDays Int?
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@map("alert_rule")
}

// ==========================================================================================
// Administration configuration (route guide §2.4 — the SI/administrator portal).
//
// The five "LATER" administration screens (RBAC, integrations, security, backups, GDPR)
// and /admin/ai were reports in the earlier port: they showed the deployment-configured
// state and edited nothing. The tables below give each of them a real place to write, so
// the console stops being a mirror of the .env file and starts being administrable.
//
// What persistence does *not* buy, and what each page says so on screen:
//   - Connector rows record the intended mode and credentials; there is still no Entra/AD
//     tenant nor SMTP relay behind them, so a "test" reports honestly that there is nothing
//     to reach rather than inventing a green tick.
//   - BackupSchedule rows record the intended schedule; no worker process exists in this
//     Express app to execute one, so `BackupRun` starts and stays empty until one does.
//   - AiConfig records provider/model/quota/prompt choices; ADR-003 keeps every business
//     feature free of an LLM dependency, so nothing consumes them yet.
// ==========================================================================================

/**
 * Custom platform roles, editable from /admin/roles.
 *
 * The four built-in roles (ADMIN/HR/MANAGER/EMPLOYEE) live in domain/auth/permissions.js as
 * code, not data, because `can()` resolves them on every request and a database round-trip
 * per authorization check is the wrong trade. A CustomRole is therefore additive: it is
 * declared here with its permission list and marked `isSystem` when it mirrors a built-in,
 * in which case the routes refuse to edit or delete it.
 */
model CustomRole {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  nameFr        String
  descriptionFr String?
  // An array of "resource:action" strings, validated against the permission catalogue.
  permissions   Json
  isSystem      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("custom_role")
}

/**
 * One external system and the mode it is meant to run in — the "Plug & Play" switch of
 * /admin/integrations. `mode` is a string rather than an enum so adding a third mode later
 * is a migration of data, not of the type; the routes constrain it to MOCK | PRODUCTION.
 */
model Connector {
  id           String    @id @default(uuid()) @db.Uuid
  key          String    @unique
  labelFr      String
  mode         String    @default("MOCK") // "MOCK" | "PRODUCTION"
  config       Json      @default("{}")
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("connector")
}

/** Single-row security policy (/admin/security). */
model SecurityPolicy {
  id                String   @id @default(uuid()) @db.Uuid
  passwordMinLength Int      @default(12)
  mfaRequired       Boolean  @default(false)
  sessionTtlSeconds Int      @default(28800)
  // An array of CIDR/IP strings. Empty means "no restriction", which is not the same as
  // "restriction not yet decided" — the page states which of the two it is.
  ipAllowlist       Json     @default("[]")
  updatedAt         DateTime @updatedAt

  @@map("security_policy")
}

/** A declared backup schedule (/admin/backups). Nothing executes these yet. */
model BackupSchedule {
  id            String      @id @default(uuid()) @db.Uuid
  labelFr       String
  cronFr        String
  retentionDays Int         @default(30)
  isActive      Boolean     @default(true)
  lastRunAt     DateTime?
  lastRunOk     Boolean?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  runs BackupRun[]

  @@map("backup_schedule")
}

/**
 * The history of executed backups. Written by a worker that does not exist yet, so this
 * table is empty by design rather than by accident — the page says as much.
 */
model BackupRun {
  id         String          @id @default(uuid()) @db.Uuid
  scheduleId String?         @db.Uuid
  schedule   BackupSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  ok         Boolean         @default(false)
  sizeBytes  BigInt?
  note       String?

  @@index([scheduleId])
  @@index([startedAt])
  @@map("backup_run")
}

/**
 * The GDPR register (/admin/gdpr): consent, erasure and export requests, logged and
 * resolved by hand. Erasure is not automated — see the categories the page lists, each of
 * which has a different correct answer — so a request is a tracked obligation, not a
 * trigger.
 */
model GdprRequest {
  id            String    @id @default(uuid()) @db.Uuid
  subjectUserId String?   @db.Uuid
  subject       User?     @relation("GdprRequestSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  kind          String // "ERASURE" | "EXPORT" | "CONSENT"
  status        String    @default("OPEN") // "OPEN" | "DONE" | "REJECTED"
  requestedAt   DateTime  @default(now())
  resolvedAt    DateTime?
  noteFr        String?

  @@index([status])
  @@index([requestedAt])
  @@map("gdpr_request")
}

/** Single-row AI configuration (/admin/ai). Nothing reads it yet (ADR-003). */
model AiConfig {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String?
  endpoint        String?
  model           String?
  monthlyQuota    Int?
  // Map of agentId -> boolean.
  agentsEnabled   Json     @default("{}")
  // Map of agentId -> prompt string.
  promptTemplates Json     @default("{}")
  updatedAt       DateTime @updatedAt

  @@map("ai_config")
}
