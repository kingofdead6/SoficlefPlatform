generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  labelFr   String
  labelAr   String?
  labelEn   String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("app_setting")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum LifecycleState {
  PENDING_ASSIGNMENT
  ASSIGNED
  ARCHIVED
}

enum ScopeType {
  GLOBAL
  ORGANIZATION_UNIT
  SELF
}

enum Occupancy {
  VACANT
  TO_FILL
  OCCUPIED
}

model OrganizationUnit {
  id       String             @id @default(uuid()) @db.Uuid
  code     String             @unique
  nameFr   String
  nameAr   String?
  nameEn   String?
  type     String
  parentId String?            @db.Uuid
  parent   OrganizationUnit?  @relation("OrganizationUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children OrganizationUnit[] @relation("OrganizationUnitTree")

  icon           String?
  descriptionFr  String?
  headOccupancy  Occupancy?
  headLabelFr    String?
  criticalNoteFr String?
  staffingFr     String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  scopes            Scope[]
  positions         Position[]
  managementMembers ManagementMember[]

  @@index([parentId])
  @@index([archivedAt])
  @@map("organization_unit")
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String
  displayName         String
  locale              String     @default("fr")
  status              UserStatus @default(ACTIVE)
  lifecycleState      LifecycleState @default(PENDING_ASSIGNMENT)
  onboardingStartDate DateTime?

  hireDate        DateTime? @db.Date
  phone           String?
  avatarUrl       String?
  directionFr     String?
  serviceFr       String?
  positionTitleFr String?
  managerId       String?   @db.Uuid
  manager         User?     @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports         User[]    @relation("UserManager")

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions            Session[]
  userRoles           UserRole[]
  auditTrail          AuditLog[]           @relation("AuditActor")
  onboardingInstances OnboardingInstance[]
  assessments         Assessment[]
  remarks             Remark[]
  welcome             Welcome?
  notifications       Notification[]
  surveyResponses     SurveyResponse[]
  trainingAttempts    TrainingAttempt[]
  assignments         Assignment[]
  managerOverrideFor  Assignment[]         @relation("AssignmentManagerOverride")
  documentAcknowledgements DocumentAcknowledgement[]
  personalFiles       PersonalFile[]
  accountRequests     AccountRequest[]     @relation("AccountRequestRequester")
  evaluationsAbout    Evaluation[]         @relation("EvaluationSubject")
  evaluationsMade     Evaluation[]         @relation("EvaluationEvaluator")
  managerTasksCreated ManagerTask[]        @relation("ManagerTaskAuthor")
  accountRequestsFor  AccountRequest[]     @relation("AccountRequestCreatedUser")
  gdprRequests        GdprRequest[]        @relation("GdprRequestSubject")
  taskComments        TaskComment[]        @relation("TaskCommentAuthor")
  taskSignatures      TaskSignature[]      @relation("TaskSignatureSigner")
  probationDecisions  ProbationDecision[]  @relation("ProbationDecider")

  @@index([status])
  @@index([lifecycleState])
  @@index([managerId])
  @@map("user")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  ip         String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique
  nameFr      String
  nameAr      String?
  nameEn      String?
  description String?

  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("role")
}

model Permission {
  id       String @id @default(uuid()) @db.Uuid
  code     String @unique
  resource String
  action   String

  roles RolePermission[]

  @@index([resource])
  @@map("permission")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

model Scope {
  id                 String            @id @default(uuid()) @db.Uuid
  type               ScopeType
  organizationUnitId String?           @db.Uuid
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)

  userRoles UserRole[]

  @@unique([type, organizationUnitId])
  @@map("scope")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  scopeId   String?  @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scope     Scope?   @relation(fields: [scopeId], references: [id], onDelete: Restrict)
  grantedAt DateTime @default(now())
  grantedBy String?  @db.Uuid

  @@unique([userId, roleId, scopeId])
  @@index([roleId])
  @@map("user_role")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorLabel String
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_log")
}

model Company {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  legalName      String
  legalForm      String
  foundedYear    Int
  foundedCity    String
  headquarters   String
  generalManager String
  certification  String
  status         String
  website        String
  visionFr       String
  missionFr      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  activities CompanyActivity[]

  @@map("company")
}

model CompanyActivity {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique
  companyId String  @db.Uuid
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  labelFr   String
  contentFr String  @db.Text
  order     Int

  @@index([companyId])
  @@map("company_activity")
}

model CompanyValue {
  id     String  @id @default(uuid()) @db.Uuid
  slug   String  @unique
  rank   Int
  nameFr String
  nameAr String
  nameEn String?

  @@map("company_value")
}

model Strategy {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique
  planFr            String
  globalObjectiveFr String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  markets       MarketObjective[]
  projects      StrategicProject[]
  contributions StrategyContribution[]

  @@map("strategy")
}

model MarketObjective {
  id                  String   @id @default(uuid()) @db.Uuid
  slug                String   @unique
  strategyId          String   @db.Uuid
  strategy            Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  marketFr            String
  strategyFr          String   @db.Text
  marketShareTargetFr String
  revenueTargetFr     String
  order               Int

  @@index([strategyId])
  @@map("market_objective")
}

model StrategicProject {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  strategyId    String   @db.Uuid
  strategy      Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  titleFr       String
  descriptionFr String   @db.Text
  order         Int

  @@index([strategyId])
  @@map("strategic_project")
}

model StrategyContribution {
  id              String   @id @default(uuid()) @db.Uuid
  slug            String   @unique
  strategyId      String   @db.Uuid
  strategy        Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
  labelFr         String
  targetFr        String
  progressPercent Int
  order           Int

  @@index([strategyId])
  @@map("strategy_contribution")
}

model Position {
  id                 String            @id @default(uuid()) @db.Uuid
  code               String            @unique
  titleFr            String
  missionFr          String?
  organizationUnitId String?           @db.Uuid
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: SetNull)

  parentPositionId String?    @db.Uuid
  parentPosition   Position?  @relation("PositionTree", fields: [parentPositionId], references: [id], onDelete: Restrict)
  childPositions   Position[] @relation("PositionTree")

  order Int @default(0)

  isVacant     Boolean    @default(false)
  occupancy    Occupancy?
  occupancyFr  String?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignments         Assignment[]
  jobDescription      JobDescription?
  jobCompetencies     JobCompetency[]
  onboardingTemplates OnboardingTemplate[]

  @@index([organizationUnitId])
  @@index([parentPositionId])
  @@index([archivedAt])
  @@map("position")
}

model Assignment {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  positionId String    @db.Uuid
  position   Position  @relation(fields: [positionId], references: [id], onDelete: Restrict)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  managerOverrideId String? @db.Uuid
  managerOverride   User?   @relation("AssignmentManagerOverride", fields: [managerOverrideId], references: [id], onDelete: SetNull)

  templateId String?             @db.Uuid
  template   OnboardingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([positionId])
  @@index([endDate])
  @@map("assignment")
}

model JobDescription {
  id                               String   @id @default(uuid()) @db.Uuid
  code                             String   @unique
  positionId                       String?   @unique @db.Uuid
  position                         Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  jobTitleFr                       String
  applicationDate                  DateTime @db.Date
  applicationDateSourceFr          String
  positioningStructureFr           String
  positioningProcessFr             String
  positioningReportsToFr           String
  positioningSubordinatesFr        String
  requirementEducationFr           String
  requirementAdditionalEducationFr String
  requirementExperienceFr          String
  requirementWorkPatternFr         String
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  missions               JobDescriptionMission[]
  permanentTasks         JobDescriptionTask[]
  responsibilities       JobDescriptionResponsibility[]
  jobDescriptionVersions JobDescriptionVersion[]

  @@map("job_description")
}

model JobDescriptionMission {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique
  jobDescriptionId String         @db.Uuid
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  textFr           String         @db.Text
  order            Int

  @@index([jobDescriptionId])
  @@map("job_description_mission")
}

model JobDescriptionTask {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique
  jobDescriptionId String         @db.Uuid
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  textFr           String         @db.Text
  order            Int

  @@index([jobDescriptionId])
  @@map("job_description_task")
}

model JobDescriptionResponsibility {
  id               String         @id @default(uuid()) @db.Uuid
  slug             String         @unique
  jobDescriptionId String         @db.Uuid
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  textFr           String         @db.Text
  order            Int

  @@index([jobDescriptionId])
  @@map("job_description_responsibility")
}

model Competency {
  id            String            @id @default(uuid()) @db.Uuid
  code          String?           @unique
  nameFr        String
  categoryFr    String?
  familyId      String?           @db.Uuid
  family        CompetencyFamily? @relation(fields: [familyId], references: [id], onDelete: SetNull)
  descriptionFr String?           @db.Text
  archivedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  jobCompetencies JobCompetency[]
  assessments     Assessment[]

  @@map("competency")
}

model JobCompetency {
  positionId    String     @db.Uuid
  competencyId  String     @db.Uuid
  position      Position   @relation(fields: [positionId], references: [id], onDelete: Cascade)
  competency    Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  requiredLevel Int
  notesFr       String?

  @@id([positionId, competencyId])
  @@index([competencyId])
  @@map("job_competency")
}

model Assessment {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competencyId String     @db.Uuid
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  level        Int
  assessedBy   String     @db.Uuid
  assessedAt   DateTime   @default(now())
  notesFr      String?    @db.Text

  @@index([userId])
  @@index([competencyId])
  @@map("assessment")
}

model ManagementMember {
  id                 String            @id @default(uuid()) @db.Uuid
  slug               String            @unique
  organizationUnitId String?           @db.Uuid
  organizationUnit   OrganizationUnit? @relation(fields: [organizationUnitId], references: [id], onDelete: SetNull)
  initials           String
  nameFr             String
  roleFr             String
  scopeFr            String
  tagFr              String
  perimeterFr        String            @db.Text
  priorityJ30Fr      String            @db.Text
  order              Int

  @@index([organizationUnitId])
  @@map("management_member")
}

model ManagementRecommendedAction {
  id         String @id @default(uuid()) @db.Uuid
  slug       String @unique
  dayOffset  Int
  dayLabelFr String
  textFr     String @db.Text
  order      Int

  @@map("management_recommended_action")
}

model KaizenProgramme {
  id             String   @id @default(uuid()) @db.Uuid
  slug           String   @unique
  programmeFr    String
  internalLeadFr String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  missions           KaizenMission[]
  priorityActionsJ30 KaizenPriorityActionJ30[]

  @@map("kaizen_programme")
}

model KaizenMission {
  id             String          @id @default(uuid()) @db.Uuid
  slug           String          @unique
  programmeId    String          @db.Uuid
  programme      KaizenProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  number         Int
  icon           String?
  titleFr        String
  periodFr       String
  referenceFr    String?
  internalLeadFr String
  contextFr      String          @db.Text

  results KaizenMissionResult[]
  journal KaizenJournalEntry[]
  gaps    KaizenGap[]
  actions KaizenAction[]

  @@index([programmeId])
  @@map("kaizen_mission")
}

model KaizenMissionResult {
  id        String        @id @default(uuid()) @db.Uuid
  slug      String        @unique
  missionId String        @db.Uuid
  mission   KaizenMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  textFr    String        @db.Text
  order     Int

  @@index([missionId])
  @@map("kaizen_mission_result")
}

model KaizenJournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  slug         String        @unique
  missionId    String        @db.Uuid
  mission      KaizenMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  dayFr        String
  activitiesFr String        @db.Text
  outcomeFr    String        @db.Text
  order        Int

  @@index([missionId])
  @@map("kaizen_journal_entry")
}

model KaizenGap {
  id         String        @id @default(uuid()) @db.Uuid
  slug       String        @unique
  missionId  String        @db.Uuid
  mission    KaizenMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  domainFr   String
  observedFr String        @db.Text
  targetFr   String        @db.Text
  order      Int

  @@index([missionId])
  @@map("kaizen_gap")
}

model KaizenAction {
  id         String        @id @default(uuid()) @db.Uuid
  slug       String        @unique
  missionId  String        @db.Uuid
  mission    KaizenMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  actionFr   String        @db.Text
  ownerFr    String
  deadlineFr String
  statusFr   String
  order      Int

  @@index([missionId])
  @@map("kaizen_action")
}

model KaizenPriorityActionJ30 {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  programmeId String          @db.Uuid
  programme   KaizenProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  dayLabelFr  String
  textFr      String          @db.Text
  order       Int

  @@index([programmeId])
  @@map("kaizen_priority_action_j30")
}

model Qms {
  id                   String   @id @default(uuid()) @db.Uuid
  slug                 String   @unique
  standardFr           String
  certificationBodyFr  String
  certifiedSinceFr     String
  certificationScopeFr String   @db.Text
  ownedProcessCode     String
  ownedProcessNoteFr   String   @db.Text
  processMapCode       String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  responsibilities QmsResponsibility[]
  processes        QmsProcess[]

  @@map("qms")
}

model QmsResponsibility {
  id     String @id @default(uuid()) @db.Uuid
  slug   String @unique
  qmsId  String @db.Uuid
  qms    Qms    @relation(fields: [qmsId], references: [id], onDelete: Cascade)
  textFr String @db.Text
  order  Int

  @@index([qmsId])
  @@map("qms_responsibility")
}

enum QmsProcessCategory {
  MANAGEMENT
  REALISATION
  SUPPORT
}

model QmsProcess {
  id                          String             @id @default(uuid()) @db.Uuid
  code                        String             @unique
  qmsId                       String             @db.Uuid
  qms                         Qms                @relation(fields: [qmsId], references: [id], onDelete: Cascade)
  category                    QmsProcessCategory
  categoryLabelFr             String
  nameFr                      String
  isOwnedByProductionDirector Boolean
  order                       Int

  @@index([qmsId])
  @@map("qms_process")
}

model Hse {
  id                    String   @id @default(uuid()) @db.Uuid
  slug                  String   @unique
  siteFr                String
  contactFr             String
  zonesFr               String   @db.Text
  riskAreaFr            String   @db.Text
  circulationPlanNoteFr String   @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  rules HseRule[]

  @@map("hse")
}

enum HseRuleKind {
  TRAFFIC
  PPE
}

model HseRule {
  id     String      @id @default(uuid()) @db.Uuid
  slug   String      @unique
  hseId  String      @db.Uuid
  hse    Hse         @relation(fields: [hseId], references: [id], onDelete: Cascade)
  kind   HseRuleKind
  textFr String
  order  Int

  @@index([hseId])
  @@map("hse_rule")
}

enum ContactPriority {
  S1
  S2
}

model Contact {
  id           String          @id @default(uuid()) @db.Uuid
  extension    String          @unique
  initials     String
  nameFr       String
  roleFr       String
  priorityFr   String
  priorityRank ContactPriority
  order        Int

  @@map("contact")
}

enum DocumentAvailability {
  AVAILABLE
  PENDING
}

model Document {
  id           String               @id @default(uuid()) @db.Uuid
  slug         String               @unique
  fileName     String?
  storageKey   String?
  titleFr      String
  detailFr     String?              @db.Text
  availability DocumentAvailability
  order        Int

  /// "ALL" (visible to anyone with document:read) or "DEPARTMENTS" (restricted to
  /// `departmentsFr`, plus anyone holding document:create who must see what they publish).
  /// TEXT rather than an enum, following Connector.mode — constrained by Zod at the route.
  visibility    String @default("ALL")
  /// Department names matched against User.directionFr / User.serviceFr.
  departmentsFr Json   @default("[]")

  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  acknowledgements DocumentAcknowledgement[]

  @@index([availability])
  @@index([visibility])
  @@map("document")
}

model DocumentAcknowledgement {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedAt DateTime @default(now())

  @@unique([documentId, userId])
  @@index([userId])
  @@map("document_acknowledgement")
}

enum PersonalFileKind {
  ID_CARD
  DIPLOMA
  BANK_DETAILS
  MEDICAL_CERTIFICATE
  OTHER
}

enum PersonalFileStatus {
  REQUESTED
  SUBMITTED
  ACCEPTED
  REJECTED
}

model PersonalFile {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @db.Uuid
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PersonalFileKind
  labelFr    String
  status     PersonalFileStatus @default(REQUESTED)
  fileName   String?
  storageKey String?
  noteFr     String?            @db.Text
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedBy  String?           @db.Uuid
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([userId, kind])
  @@index([status])
  @@map("personal_file")
}

enum AccountRequestStatus {
  OPEN
  CREATED
  REJECTED
}

enum AccountRequestUrgency {
  NORMAL
  URGENT
}

model AccountRequest {
  id               String                @id @default(uuid()) @db.Uuid
  candidateNameFr  String
  plannedPositionFr String
  plannedHireDate  DateTime?             @db.Date
  urgency          AccountRequestUrgency @default(NORMAL)
  noteFr           String?               @db.Text
  status           AccountRequestStatus  @default(OPEN)
  requestedById    String                @db.Uuid
  requestedBy      User                  @relation("AccountRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  createdUserId    String?               @db.Uuid
  createdUser      User?                 @relation("AccountRequestCreatedUser", fields: [createdUserId], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, createdAt])
  @@map("account_request")
}

model Recruitment {
  id                     String   @id @default(uuid()) @db.Uuid
  slug                   String   @unique
  internalMobilityNoteFr String   @db.Text
  recommendedActionFr    String   @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  positions OpenPosition[]

  @@map("recruitment")
}

model OpenPosition {
  id            String      @id @default(uuid()) @db.Uuid
  slug          String      @unique
  recruitmentId String      @db.Uuid
  recruitment   Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  titleFr       String
  attachmentFr  String
  statusFr      String
  order         Int

  @@index([recruitmentId])
  @@map("open_position")
}

model Welcome {
  id                String   @id @default(uuid()) @db.Uuid
  slug              String   @unique
  userId            String?  @unique @db.Uuid
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  recipientFr       String
  recipientRoleFr   String
  startDate         DateTime @db.Date
  startDateSourceFr String
  greetingFr        String
  messageFr         String   @db.Text
  signatureFr       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stats  WelcomeStat[]
  agenda WelcomeAgendaItem[]

  @@map("welcome")
}

