/// The trial-period decision HR records once the responsable's evaluation is submitted.
///
/// `scorePercent` and `suggestedOutcome` are what domain/onboarding/probation.js computed at
/// the moment of the decision, stored rather than recomputed on read: if the thresholds are
/// ever retuned, past decisions must not retroactively change meaning. `reasonFr` is
/// required by POST /onboarding/probation/decide whenever `decidedOutcome` differs from
/// `suggestedOutcome` — overriding the arithmetic is allowed, silently is not.
model ProbationDecision {
  id         String             @id @default(uuid()) @db.Uuid
  instanceId String             @db.Uuid
  instance   OnboardingInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  evaluationId String?     @db.Uuid
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)

  scorePercent     Int
  suggestedOutcome String
  decidedOutcome   String
  reasonFr         String? @db.Text

  decidedById String   @db.Uuid
  decidedBy   User     @relation("ProbationDecider", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime @default(now())

  @@index([instanceId])
  @@map("probation_decision")
}

enum OnboardingTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  VALIDATED
}

model OnboardingTaskCompletion {
  id          String               @id @default(uuid()) @db.Uuid
  instanceId  String               @db.Uuid
  instance    OnboardingInstance   @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  milestoneId String               @db.Uuid
  milestone   OnboardingMilestone  @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  status      OnboardingTaskStatus @default(TODO)
  completedAt DateTime?
  completedBy String?              @db.Uuid
  validatedBy String?              @db.Uuid
  validatedAt DateTime?
  noteFr      String?              @db.Text
  dueDate     DateTime?            @db.Date

  comments   TaskComment[]
  signatures TaskSignature[]

  @@unique([instanceId, milestoneId])
  @@index([milestoneId])
  @@map("onboarding_task_completion")
}

/**
 * The comment thread of a single onboarding task (route guide §2.1, task detail page).
 *
 * Hung off the completion rather than the milestone: a milestone is template content shared
 * by every recruit, while the conversation is about one person's run of it.
 */
model TaskComment {
  id           String                   @id @default(uuid()) @db.Uuid
  completionId String                   @db.Uuid
  completion   OnboardingTaskCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  authorId     String                   @db.Uuid
  author       User                     @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  bodyFr       String                   @db.Text
  createdAt    DateTime                 @default(now())

  @@index([completionId])
  @@map("task_comment")
}

/**
 * An acknowledgement record for a task that carries a document to agree to (the contract,
 * the IT charter…), which §2.1 calls "e-signature".
 *
 * It is not a qualified electronic signature and this schema does not pretend otherwise:
 * no certificate, no signing key, no timestamping authority exists in this deployment.
 * What is stored is *who* agreed, to *what exact wording*, and *when*, plus a SHA-256 over
 * those values so that a later edit of the stored statement is detectable. The page that
 * writes it states that limitation to the signer before they agree.
 */
model TaskSignature {
  id            String                   @id @default(uuid()) @db.Uuid
  completionId  String                   @db.Uuid
  completion    OnboardingTaskCompletion @relation(fields: [completionId], references: [id], onDelete: Cascade)
  signerId      String                   @db.Uuid
  signer        User                     @relation("TaskSignatureSigner", fields: [signerId], references: [id], onDelete: Cascade)
  signedAt      DateTime                 @default(now())
  statementFr   String                   @db.Text
  signatureHash String

  @@unique([completionId, signerId])
  @@map("task_signature")
}

