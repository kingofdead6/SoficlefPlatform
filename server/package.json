{
  "name": "soficlef-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOFICLEF platform — Express + Prisma backend (migrated from Next.js)",
  "scripts": {
    "dev": "node --watch index.js",
