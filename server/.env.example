NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://user:password@localhost:5432/soficlef?schema=public

AUTH_SESSION_SECRET=change-me-to-a-long-random-string
AUTH_SESSION_TTL_SECONDS=43200
AUTH_SESSION_RENEW_WINDOW_SECONDS=3600

AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1
AUTH_PASSWORD_MIN_LENGTH=12

AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_IP_MAX_FAILURES=20

# Cloudinary — fill in with real credentials before using upload/document features
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Hugging Face Inference API (OpenAI-compatible router) — powers the assistant's phrasing.
# Leave HF_API_KEY blank and the assistant falls back to retrieval-only answers: it still
# works, still cites its sources, and simply lists the matched rows instead of rephrasing
# them. The key improves the wording; it does not enable the feature.
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_BASE_URL=https://router.huggingface.co/v1
HF_TIMEOUT_MS=20000
HF_MAX_TOKENS=400
