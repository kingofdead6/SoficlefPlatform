# SOFICLEF platform — environment template.
#
# Copy to .env and fill in. Never commit .env; never put a real credential in this
# file (ADR-023). Every variable is parsed by src/lib/env.ts at start-up, so a missing
# or malformed value fails fast with a readable message.

# ── Runtime ──────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development

# Public base URL of the application. Used for absolute links and cookie scope.
APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string. With docker compose the host is the service name `db`.
# Local, without Docker: postgresql://soficlef:CHANGE_ME@localhost:5432/soficlef?schema=public
DATABASE_URL=postgresql://soficlef:CHANGE_ME@db:5432/soficlef?schema=public

# Credentials the `db` service is created with. Compose composes DATABASE_URL from them.
POSTGRES_USER=soficlef
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=soficlef
# Host port for the database. Change if 5432 is already taken locally.
POSTGRES_PORT=5432

# ── Application container ────────────────────────────────────────────────────
APP_PORT=3000
# development (hot reload, source mounted) | production (built image)
APP_TARGET=development

# ── Authentication (Part 3) ──────────────────────────────────────────────────
# Secret used to derive the session token hash. At least 32 random characters.
# Generate one with: openssl rand -base64 48
AUTH_SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Session lifetime in seconds, and the sliding-renewal window (Part 3).
AUTH_SESSION_TTL_SECONDS=43200
AUTH_SESSION_RENEW_WINDOW_SECONDS=3600

# Password policy. Configurable rather than hardcoded (ADR-012); SOFICLEF IT security
# may impose its own values.
AUTH_PASSWORD_MIN_LENGTH=12

# Argon2id parameters. Raise as hardware improves.
AUTH_ARGON2_MEMORY_KIB=19456
AUTH_ARGON2_ITERATIONS=2
AUTH_ARGON2_PARALLELISM=1

# Login rate limiting: attempts per window, and the window in seconds.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900

# ── Notes ────────────────────────────────────────────────────────────────────
# No AI provider key belongs here. The AI agent is phase 2 and will be server-side
# only; the browser will never hold a key (ADR-003).
